# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# Codex Sale (OpenAI-compatible) API credentials
CODEX_SALE_API_KEY=sk-inv-your-key-here
CODEX_SALE_BASE_URL=https://codex.sale/v1

# Default chat model (one of: gpt-5.3-codex, gpt-5.4, gpt-5.4-mini, gpt-5.5)
DEFAULT_CHAT_MODEL=gpt-5.5

# Image generation model
DEFAULT_IMAGE_MODEL=gpt-image-2

# Optional: system prompt prepended to every dialog
SYSTEM_PROMPT=You are a helpful assistant. Answer concisely.

# Optional: max number of message turns to keep per user (user+assistant pair counts as 2)
MAX_HISTORY_MESSAGES=20

# Optional: comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=
