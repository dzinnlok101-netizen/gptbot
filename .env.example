# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Codex Sale (OpenAI-compatible) API key
CODEX_SALE_API_KEY=

# OpenAI-compatible base URL
CODEX_SALE_BASE_URL=https://codex.sale/v1

# Default chat model (one of gpt-5.3-codex, gpt-5.4, gpt-5.4-mini, gpt-5.5)
DEFAULT_CHAT_MODEL=gpt-5.5

# Image generation model
DEFAULT_IMAGE_MODEL=gpt-image-2

# System prompt prepended to every conversation
SYSTEM_PROMPT=You are a helpful assistant. Answer concisely.

# How many recent messages of history to include in each completion call
MAX_HISTORY_MESSAGES=20

# Optional comma-separated whitelist (leave empty to allow everyone)
ALLOWED_USER_IDS=

# Comma-separated list of admin user IDs (gets /stats and /grant)
ADMIN_USER_IDS=

# --- Monetization ---

# Free credits given on first /start
TRIAL_TEXT_CREDITS=5
TRIAL_IMAGE_CREDITS=1

# Channel users must subscribe to in order to claim the bonus.
# Provide either the username (with or without @) or full URL.
# IMPORTANT: the bot has to be added as administrator of this channel for
# subscription verification (getChatMember) to work.
CHANNEL_USERNAME=investor_giftov
CHANNEL_URL=https://t.me/investor_giftov

# One-time bonus granted when a user verifies their subscription
CHANNEL_BONUS_TEXT=20
CHANNEL_BONUS_IMAGE=3

# Bonus the referrer gets each time a new user joins via their /ref link
REFERRAL_BONUS_TEXT=10
REFERRAL_BONUS_IMAGE=1

# SQLite database file (relative to working directory)
DATABASE_PATH=gptbot.db

# Star packs (uncomment to override defaults)
# Defaults:
#   small  — 50  ⭐ → +50 text, +3 image
#   medium — 150 ⭐ → +200 text, +15 image
#   large  — 500 ⭐ → unlimited 7 days
# STAR_PACKS_SMALL_STARS=50
# STAR_PACKS_SMALL_TEXT=50
# STAR_PACKS_SMALL_IMAGE=3
# STAR_PACKS_MEDIUM_STARS=150
# STAR_PACKS_MEDIUM_TEXT=200
# STAR_PACKS_MEDIUM_IMAGE=15
# STAR_PACKS_LARGE_STARS=500
# STAR_PACKS_LARGE_UNLIMITED_DAYS=7
